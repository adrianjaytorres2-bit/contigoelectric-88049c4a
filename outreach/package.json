{
  "name": "outreach",
  "version": "0.2.0",
  "description": "AT DEV GROUP Outreach Studio — website-audit cold outreach, self-hosted",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "bin": {
    "outreach": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "app": "electron .",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "release:win": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "electron-updater": "^6.8.9",
    "imapflow": "^1.0.164",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.16",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.atdevgroup.outreach",
    "productName": "AT DEV GROUP Outreach",
    "asar": false,
    "files": [
      "electron/**/*",
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "adrianjaytorres2-bit",
        "repo": "contigoelectric-88049c4a",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "AT DEV GROUP Outreach"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
